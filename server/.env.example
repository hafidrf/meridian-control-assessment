PORT=4000
NODE_ENV=development
# Replace these placeholders with real secrets outside local development.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
DATABASE_PATH=./data/meridian.db
# Comma-separated origin allowlist. Never use "*" together with credentials.
CORS_ORIGIN=http://localhost:5173,http://localhost:4000
UPLOAD_DIR=./uploads
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
